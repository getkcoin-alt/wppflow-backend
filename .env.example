NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://localhost:5432/wppflow
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Address of the web app, used in emailed links. Production defaults to https://scriwo.com and treats an old *.vercel.app value as that.
APP_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
TOKEN_DIR=./tokens
AUTO_MIGRATE=false
# Production requires a persistent TOKEN_DIR volume, a backup and reviewed migration.
# Optional private S3-compatible media bucket. Configure bucket CORS for APP_URL.
# S3_BUCKET=
# S3_ENDPOINT=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# Optional AI assistant (Riwo): suggested replies, summaries, translation and rewriting. Off until a key is set.
# Free models through OpenRouter (https://openrouter.ai). The key goes only in this file on the server, never in the code.
# OPENROUTER_API_KEY=
# Optional: your own ordered list of OpenRouter models. Left empty, the best currently free text models are
# found and ranked automatically, and OpenRouter's own free router is the last resort.
# AI_MODELS=google/gemma-4-31b-it:free,openai/gpt-oss-120b:free
# Optional: only use providers that don't keep or train on what they receive. Most free models have none, so this
# often leaves no model to use. Without it, OpenRouter's privacy settings for your account apply.
# AI_DATA_COLLECTION=deny
# Or use Claude from Anthropic instead (used when there is no OpenRouter key, or when AI_PROVIDER=anthropic).
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_PROVIDER=openrouter
# Requests each company may make per day (a company can have its own limit in tenants.ai_daily_limit).
# AI_DAILY_LIMIT=300
# Explicit operator-verified legacy mappings only, never infer ownership from company labels.
# LEGACY_TENANT_MAP={"1":"verified_workspace_id","2":"verified_workspace_id"}
# LEGACY_SESSION_OWNERS={"primary-whatsapp":"verified_workspace_id"}

# Email service (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=WppFlow <noreply@scriwo.com>
SUPERADMIN_EMAIL=karnveer@scriza.in


# Online payment (Razorpay). Checkout is off unless all three are set. Put them in this file on the server only:
# never in the repository, in chat or in the browser. The mode follows the key: rzp_test_ keys take test payments,
# rzp_live_ keys take real money. The webhook secret is the one you type when you add the webhook in the Razorpay
# dashboard (event URL: https://app.scriwo.com/api/billing/razorpay/webhook), not the API key secret.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# The service code printed on invoices; the accountant confirms it before the first live invoice.
# SELLER_SAC_CODE=998314
# Credit the unused days of the current plan when a company moves to a bigger plan (default true).
# BILLING_PRORATE_UPGRADES=true

# Anyone can create a workspace from the sign-in page. It starts on the Free plan (one person, one number);
# the platform admin moves a company to a paid plan. Set to false to turn sign-up off, so every company
# is created by the platform admin.
# ALLOW_PUBLIC_SIGNUP=true

# "Continue with Google" on the sign-in and sign-up pages. Create an OAuth client (type: Web application) in Google Cloud,
# register https://app.scriwo.com/api/auth/google/callback as its redirect URI, then set both values. Without them the
# Google button is simply not shown. The secret belongs on the server only.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Only if the callback is served from another address than APP_URL + /api/auth/google/callback:
# GOOGLE_REDIRECT_URI=
